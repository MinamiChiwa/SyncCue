<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="SyncCue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SyncCue"
        Width="480" Height="720"
        MinWidth="340" MinHeight="200"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#16181E"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13">
  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#3D7EFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                    Opacity="{TemplateBinding Opacity}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Background" Value="#2A2F3A"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="BorderBrush" Value="#3E4555"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}" Opacity="{TemplateBinding Opacity}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Background" Value="#22262F"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="BorderBrush" Value="#3E4555"/>
      <Setter Property="CaretBrush" Value="#F2F2F2"/>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,0,8,4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#3D7EFF"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C8CDD8"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="14">
    <Border DockPanel.Dock="Top" Padding="0,0,0,12" BorderBrush="#2A2F3A" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="CountdownText" Text="— —" FontSize="56" FontWeight="Bold"
                     Foreground="#FFFFFF" Margin="0,0,0,2"/>
          <TextBlock x:Name="CueCaption" Text="① 先选开房或加入" FontSize="14" Foreground="#9AA3B2"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock x:Name="RoomLabel" Text="还没进房" FontWeight="SemiBold" Foreground="#E8ECF4" Margin="0,0,12,0"/>
            <TextBlock x:Name="SyncStatus" Text="等待进房" Foreground="#7F8796" FontSize="12"/>
          </StackPanel>
          <StackPanel x:Name="CompactActionRow" Orientation="Horizontal" Margin="0,10,0,0">

          <Button x:Name="CompactStartButton" Content="开始倒计时" Style="{StaticResource PrimaryButton}"
                  Click="Start_Click" HorizontalAlignment="Left" Margin="0,0,8,0" Padding="18,12"
                  IsEnabled="False" Opacity="0.45"/>

            <Button x:Name="CompactReadyButton" Content="我已就绪"

                    Style="{StaticResource PrimaryButton}" Background="#3D7EFF"

                    Click="ReadyToggle_Click" Padding="18,10" Visibility="Collapsed"/>

          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">
          <Button x:Name="ToggleExpandButton" Style="{StaticResource SecondaryButton}" Content="收起设置"
                  Click="ToggleExpand_Click" Margin="0,0,0,8" Padding="10,6"/>
          <ToggleButton x:Name="TopmostToggle" Content="置顶" IsChecked="True"
                        Checked="TopmostToggle_Changed" Unchecked="TopmostToggle_Changed"
                        Padding="10,6" Background="#2A2F3A" Foreground="#F2F2F2"
                        BorderBrush="#3E4555" BorderThickness="1"/>
        </StackPanel>
      </Grid>
    </Border>

    
    <Border x:Name="MembersCard" DockPanel.Dock="Top" Visibility="Collapsed"
            Background="#152033" Padding="12" Margin="0,10,0,0" CornerRadius="10"
            BorderBrush="#3D7EFF" BorderThickness="2">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <TextBlock Text="成员" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="MembersSummaryText" DockPanel.Dock="Right"
                     Foreground="#B8C0D0" FontSize="13" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="MembersList" MinHeight="100" MaxHeight="200"
                 Background="#0F141C" BorderBrush="#2A2F3A" BorderThickness="1"
                 Foreground="#F2F2F2" FontSize="15" FontWeight="SemiBold" Padding="8"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="StatusMessage" DockPanel.Dock="Bottom" Text="" TextWrapping="Wrap"
               Margin="0,10,0,0" Foreground="#A8B0C0" FontSize="12"/>

    <ScrollViewer x:Name="ExpandedPanel" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="开房或加入" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
        <TextBlock Text="昵称" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="NicknameBox" Text="选手 1"/>

        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.15*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Background="#1C2433" CornerRadius="10" Padding="12" Margin="0,0,6,0"
                  BorderBrush="#2F5AA8" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="我是房主" FontWeight="SemiBold" Foreground="#7EB6FF" Margin="0,0,0,8"/>
              <TextBlock Text="倒计时秒数" FontSize="12" Margin="0,0,0,4"/>
              <TextBox x:Name="DurationBox" Text="10" Margin="0,0,0,4"/>
              <TextBlock Text="只在开房时生效，已开的房改这里不会变。" FontSize="11"
                         Foreground="#F0A020" Margin="0,0,0,10" TextWrapping="Wrap"/>
              <TextBlock Text="开房后会自动展开邀请，方便复制给别人。" FontSize="11" Foreground="#7F8796"
                         Margin="0,0,0,8" TextWrapping="Wrap"/>
              <Button Content="开房" Style="{StaticResource PrimaryButton}" Click="Create_Click"
                      HorizontalAlignment="Stretch" Margin="0"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Background="#1C2433" CornerRadius="10" Padding="12" Margin="6,0,0,0"
                  BorderBrush="#3E4555" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="我要加入" FontWeight="SemiBold" Foreground="#B8C0D0" Margin="0,0,0,6"/>
              <TextBlock Text="把好友发你的整段贴这里" FontSize="12" Margin="0,0,0,4" Foreground="#E8ECF4"/>
              <TextBox x:Name="InvitePasteBox" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="64" VerticalScrollBarVisibility="Auto"
                       ToolTip="可整段粘贴：第一行链接，第二行房码 …"/>
              <Button Content="解析并填入" Style="{StaticResource SecondaryButton}"
                      Click="ParseInvite_Click" Padding="10,6" Margin="0,0,0,8" HorizontalAlignment="Left"/>

              <TextBlock Text="服务链接" FontSize="12" Margin="0,0,0,4"/>
              <TextBox x:Name="EndpointBox" Text="ws://127.0.0.1:3131" Margin="0,0,0,4"/>
              <TextBlock x:Name="EndpointHint" Text="" FontSize="11" Foreground="#F0A020"
                         TextWrapping="Wrap" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="恢复默认" Style="{StaticResource SecondaryButton}"
                        Click="RestoreDefaultEndpoint_Click" Padding="10,6" Margin="0,0,8,0"/>
                <Button Content="仅连接" Style="{StaticResource SecondaryButton}"
                        Click="Connect_Click" Padding="10,6" Margin="0"/>
              </StackPanel>
              <TextBlock x:Name="ConnectionBadge" Text="未进房" Margin="0,0,0,8" Foreground="#F0A020" FontSize="12"/>

              <TextBlock Text="房间码（只要码，不要填端口号）" FontSize="12" Margin="0,0,0,4"/>
              <TextBox x:Name="CodeBox" Margin="0,0,0,10" ToolTip="例如 AB12，不要把 3131 填进来"/>
              <Button Content="连接并加入" Style="{StaticResource PrimaryButton}" Background="#4A5568"
                      Click="ConnectAndJoin_Click" HorizontalAlignment="Stretch" Margin="0"/>
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock Text="房间操作" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,16,0,8"/>
        <WrapPanel>
          <Button x:Name="ExpandedStartButton" Content="开始倒计时" Style="{StaticResource PrimaryButton}"
                  Click="Start_Click" Margin="0,0,8,8" IsEnabled="False" Opacity="0.45"/>

          <Button x:Name="ExpandedReadyButton" Content="我已就绪"

                  Style="{StaticResource PrimaryButton}" Background="#3D7EFF"

                  Click="ReadyToggle_Click" Margin="0,0,8,8" Padding="16,10" Visibility="Collapsed"/>

          <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
          <Button Content="离开" Style="{StaticResource SecondaryButton}" Click="Leave_Click"/>
          <Button Content="关闭房间" Style="{StaticResource SecondaryButton}" Click="CloseRoom_Click"/>
        </WrapPanel>

        <TextBlock Text="提前量与音量" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,8,0,8"/>
        <StackPanel Margin="0,0,0,4">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="提前量" VerticalAlignment="Center" Width="48"/>
            <TextBlock x:Name="LeadValueText" DockPanel.Dock="Right" Text="+0 ms" Width="72"
                       TextAlignment="Right" VerticalAlignment="Center" Foreground="#E8ECF4"/>
            <Slider x:Name="LeadSlider" Minimum="-2000" Maximum="2000" Value="0"
                    ValueChanged="LeadSlider_Changed"/>
          </DockPanel>
          <TextBlock x:Name="LeadHintText" FontSize="11" Foreground="#9AA3B2" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="正数＝自己更早响（补偿设备延迟）；负数＝更晚响。"/>
        </StackPanel>

        <DockPanel Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Left" Text="音量" VerticalAlignment="Center" Width="48"/>
          <TextBlock x:Name="VolumeValueText" DockPanel.Dock="Right" Text="60%" Width="72"
                     TextAlignment="Right" VerticalAlignment="Center" Foreground="#E8ECF4"/>
          <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="60" TickFrequency="1"
                  IsSnapToTickEnabled="True" ValueChanged="VolumeSlider_Changed"/>
        </DockPanel>

        <Border Background="#1A1F28" CornerRadius="10" Padding="12" Margin="0,4,0,0"
                BorderBrush="#2F3340" BorderThickness="1">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="公网隧道" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
              <TextBlock x:Name="TunnelBadge" DockPanel.Dock="Right" Text="未开" Foreground="#9AA3B2"
                         VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="给外网朋友用。开通后点「复制外网邀请」。关房／退出会自动关掉。" FontSize="11"
                       Foreground="#7F8796" Margin="0,4,0,10" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="TunnelStartButton" Content="开隧道" Style="{StaticResource PrimaryButton}"
                      Click="TunnelStart_Click" Margin="0,0,8,0"/>
              <Button Content="关隧道" Style="{StaticResource SecondaryButton}" Click="TunnelStop_Click" Margin="0"/>
            </StackPanel>
            <TextBlock x:Name="TunnelUrlText" Text="" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="#7EB6FF" FontSize="12"/>
            <TextBlock x:Name="TunnelMessageText" Text="隧道未开，局域网仍可用。" Margin="0,4,0,0"
                       TextWrapping="Wrap" Foreground="#9AA3B2" FontSize="11"/>
          </StackPanel>
        </Border>

        <Border x:Name="InvitationBox" Visibility="Collapsed" Background="#1A1F28" Padding="12"
                Margin="0,10,0,0" CornerRadius="10" BorderBrush="#2F5AA8" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="邀请（开房后已展开）" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
            <TextBlock x:Name="ShareAddressText" Text="" TextWrapping="Wrap" Foreground="#E8ECF4"/>
            <TextBlock x:Name="ShareCodeText" Text="" Margin="0,4,0,10" Foreground="#9AA3B2"/>
            <WrapPanel>
              <Button Content="复制给局域网" Style="{StaticResource PrimaryButton}"
                      Click="CopyLanInvite_Click" Margin="0,0,8,8"/>
              <Button x:Name="CopyPublicInviteButton" Content="复制外网邀请" Style="{StaticResource SecondaryButton}"
                      Click="CopyPublicInvite_Click" Margin="0,0,8,8" IsEnabled="False" Opacity="0.5"/>
            </WrapPanel>
            <TextBlock Text="局域网＝同一 Wi‑Fi；外网＝先开隧道再复制。整段发给对方，对方可直接粘贴进「加入」。"
                       FontSize="11" Foreground="#7F8796" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Button Content="开第二窗口" Style="{StaticResource SecondaryButton}"
                Click="OpenSecondWindow_Click" Margin="0,14,0,0" HorizontalAlignment="Left"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
